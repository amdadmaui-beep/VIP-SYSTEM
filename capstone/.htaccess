<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

Options -Indexes

ErrorDocument 404 /VIP-system/capstone/404.html
ErrorDocument 500 /VIP-system/capstone/500.html
ErrorDocument 503 /VIP-system/capstone/503.html

<FilesMatch "^(\.env|.*\.sql|.*\.log|.*\.bak|.*\.old|composer\.(json|lock)|columns\.txt)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(bypass.*|check_.*|schema_dump.*|test[0-9]*|migrate_.*)\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block sensitive directories
    RewriteRule ^(scratch|database|tests|scripts|cursor-skill|objectives|SKILLS|docs|vendor)(/|$) - [F,L]
</IfModule>
