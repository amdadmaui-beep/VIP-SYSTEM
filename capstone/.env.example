# VIP System Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Routing Provider
# ROUTING_PROVIDER=ors
# OSRM_BASE_URL=https://router.project-osrm.org
# OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
# OPENROUTESERVICE_API_KEY=

# Database Configuration
DB_HOST=localhost
DB_USER=your_database_username
DB_PASS=your_secure_password
DB_NAME=vip_db
DB_CHARSET=utf8mb4

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/VIP-system/capstone

# Security Settings
CSRF_TOKEN_LIFETIME=3600
SESSION_LIFETIME=7200

# Email Settings (for AR reminders)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=noreply@vipsystem.com
MAIL_FROM_NAME=VIP-System
MAIL_ENCRYPTION=tls

# SMS Provider (UniSMS)
SMS_UNISMS_API_KEY=

# Encryption Key (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Credit Limit Settings
CREDIT_LIMIT_ENABLED=false
CREDIT_LIMIT_WARNING_THRESHOLD=0.9

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=

# AI Chatbot (Gemini) — Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
